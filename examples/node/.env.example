# 默认模拟模式，不调用支付宝，不需要真实 Key。
PAYMENT_MODE=mock
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DEMO_PASSWORD=local-demo-password
DEMO_USER_ID=example-user-1
DATABASE_PATH=./data/example.sqlite
# 真实模式：PAYMENT_MODE=live，配置下面的 Key 和 HTTPS PUBLIC_ORIGIN。
# 将 DEMO_PASSWORD 换成自己的长密码；示例登录只适用于演示账号。
opcpay_api_key=
