{
  "name": "opcpay",
  "version": "0.3.1",
  "description": "一人公司快捷收款接入，支持支付宝，由支付宝管理次数与积分权益",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md",
    "skills/",
    "scripts/install-skill.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:example": "node --test examples/node/test/*.test.mjs",
    "test:all": "npm test && npm run test:types && npm run test:example"
  },
  "keywords": [
    "opcpay",
    "payment",
    "alipay"
  ],
  "homepage": "https://ai6666.com/opcpay/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yapie0/opcpay.git"
  },
  "bugs": {
    "url": "https://github.com/Yapie0/opcpay/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "types": "./index.d.ts",
  "bin": {
    "opcpay-skill": "./scripts/install-skill.mjs"
  }
}
